{
  "name": "dk-whale-pet",
  "version": "1.0.0",
  "description": "DK 鲸鱼宠物 —— DeepSeek Harness 浏览器端装饰插件（座头鲸妈妈+宝宝，全界面慢速漫游、可拖拽、点击对话）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "license": "MIT"
}
